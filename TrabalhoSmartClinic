<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartClinic | Gestão Integrada para Clínicas</title>
    <style>
        :root {
            --primary: #0f766e;
            --primary-dark: #115e59;
            --primary-light: #ccfbf1;
            --secondary: #2563eb;
            --success: #16a34a;
            --warning: #d97706;
            --danger: #dc2626;
            --purple: #7c3aed;
            --slate-50: #f8fafc;
            --slate-100: #f1f5f9;
            --slate-200: #e2e8f0;
            --slate-300: #cbd5e1;
            --slate-500: #64748b;
            --slate-600: #475569;
            --slate-700: #334155;
            --slate-800: #1e293b;
            --slate-900: #0f172a;
            --white: #ffffff;
            --shadow: 0 18px 45px rgba(15, 23, 42, 0.10);
            --radius-lg: 24px;
            --radius-md: 16px;
            --radius-sm: 10px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Inter, "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at top left, #e0f2fe 0, transparent 35%), linear-gradient(135deg, #ecfeff 0%, #f8fafc 45%, #eef2ff 100%);
            color: var(--slate-800);
        }

        button, input, textarea, select {
            font: inherit;
        }

        button {
            border: none;
        }

        .login-screen {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.08fr 0.92fr;
            align-items: center;
            gap: 32px;
            padding: 46px;
        }

        .hero-panel {
            background: linear-gradient(145deg, rgba(15, 118, 110, 0.95), rgba(37, 99, 235, 0.88));
            color: var(--white);
            border-radius: 34px;
            min-height: 640px;
            padding: 54px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }

        .hero-panel::before, .hero-panel::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,0.13);
        }

        .hero-panel::before {
            top: -90px;
            right: -70px;
        }

        .hero-panel::after {
            bottom: -120px;
            left: 12%;
        }

        .brand {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .brand-mark {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            background: rgba(255,255,255,0.18);
            border: 1px solid rgba(255,255,255,0.22);
            font-weight: 900;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 720px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.18);
            margin-bottom: 18px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .hero-content h1 {
            font-size: clamp(40px, 5vw, 68px);
            line-height: 1;
            letter-spacing: -0.06em;
            margin-bottom: 22px;
        }

        .hero-content p {
            font-size: 18px;
            line-height: 1.7;
            color: rgba(255,255,255,0.86);
            max-width: 650px;
        }

        .hero-metrics {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .hero-metric {
            padding: 18px;
            border-radius: 18px;
            background: rgba(255,255,255,0.13);
            border: 1px solid rgba(255,255,255,0.17);
            backdrop-filter: blur(12px);
        }

        .hero-metric strong {
            display: block;
            font-size: 28px;
            margin-bottom: 4px;
        }

        .hero-metric span {
            color: rgba(255,255,255,0.80);
            font-size: 13px;
        }

        .login-card {
            background: rgba(255,255,255,0.90);
            backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,0.80);
            border-radius: 30px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .login-header {
            padding: 34px 34px 18px;
        }

        .login-header h2 {
            color: var(--slate-900);
            font-size: 30px;
            letter-spacing: -0.04em;
            margin-bottom: 10px;
        }

        .login-header p {
            color: var(--slate-500);
            line-height: 1.6;
        }

        .tabs {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            padding: 0 34px 20px;
        }

        .tab-btn {
            padding: 11px 8px;
            border-radius: 12px;
            background: var(--slate-100);
            color: var(--slate-600);
            font-weight: 800;
            cursor: pointer;
            transition: 0.25s ease;
            font-size: 13px;
        }

        .tab-btn:hover, .tab-btn.active {
            color: var(--primary-dark);
            background: var(--primary-light);
            transform: translateY(-1px);
        }

        .login-form {
            padding: 0 34px 34px;
        }

        .role-note {
            padding: 14px 16px;
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 14px;
            margin-bottom: 18px;
            font-size: 14px;
            line-height: 1.5;
        }

        .input-group {
            margin-bottom: 16px;
        }

        .input-group label {
            display: block;
            margin-bottom: 7px;
            color: var(--slate-700);
            font-size: 14px;
            font-weight: 800;
        }

        .input-group input, .input-group textarea, .input-group select {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid var(--slate-300);
            border-radius: 13px;
            font-size: 15px;
            transition: 0.25s ease;
            background: var(--white);
            color: var(--slate-800);
        }

        .input-group input:focus, .input-group textarea:focus, .input-group select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.12);
        }

        .submit-btn, .btn-primary, .btn-secondary, .btn-ghost {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 13px;
            cursor: pointer;
            font-weight: 900;
            transition: 0.25s ease;
            white-space: nowrap;
        }

        .submit-btn, .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: var(--white);
            padding: 12px 16px;
            box-shadow: 0 12px 24px rgba(15, 118, 110, 0.20);
        }

        .submit-btn {
            width: 100%;
            margin-top: 6px;
            font-size: 16px;
        }

        .btn-secondary {
            background: var(--white);
            color: var(--primary-dark);
            border: 1px solid var(--slate-200);
            padding: 11px 15px;
        }

        .btn-ghost {
            background: transparent;
            color: var(--slate-600);
            padding: 9px 12px;
        }

        .submit-btn:hover, .btn-primary:hover, .btn-secondary:hover, .btn-ghost:hover {
            transform: translateY(-2px);
            filter: brightness(0.98);
        }

        .dashboard-screen {
            display: none;
            width: 100%;
            height: 100vh;
            background: var(--slate-100);
            overflow: hidden;
        }

        .sidebar {
            width: 292px;
            background: #0b1220;
            color: var(--white);
            display: flex;
            flex-direction: column;
            z-index: 10;
            border-right: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-header {
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-header .brand-mark {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
        }

        .sidebar-header strong {
            display: block;
            font-size: 19px;
            letter-spacing: -0.03em;
        }

        .sidebar-header small {
            color: #94a3b8;
        }

        .user-info {
            margin: 18px;
            padding: 18px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 18px;
        }

        .avatar-line {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: var(--primary-light);
            color: var(--primary-dark);
            display: grid;
            place-items: center;
            font-weight: 900;
        }

        .user-info h4 {
            margin-bottom: 4px;
        }

        .user-info p {
            color: #94a3b8;
            font-size: 13px;
        }

        .menu-list {
            list-style: none;
            padding: 6px 12px 18px;
            flex: 1;
            overflow-y: auto;
        }

        .menu-item {
            margin: 5px 0;
            padding: 12px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #cbd5e1;
            cursor: pointer;
            transition: 0.25s ease;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 800;
        }

        .menu-item:hover:not(.locked), .menu-item.active-menu {
            background: rgba(255,255,255,0.10);
            color: var(--white);
            transform: translateX(3px);
        }

        .menu-item.active-menu {
            box-shadow: inset 4px 0 0 var(--primary-light);
        }

        .menu-item.locked {
            opacity: 0.36;
            cursor: not-allowed;
        }

        .menu-icon {
            display: inline-flex;
            width: 28px;
            height: 28px;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: rgba(255,255,255,0.07);
            margin-right: 8px;
            font-size: 12px;
        }

        .lock-icon {
            display: none;
            font-size: 11px;
            padding: 3px 7px;
            border-radius: 999px;
            background: rgba(255,255,255,0.12);
        }

        .menu-item.locked .lock-icon {
            display: inline-flex;
        }

        .logout-btn {
            margin: 14px 18px 20px;
            padding: 13px 18px;
            background: rgba(220,38,38,0.14);
            color: #fecaca;
            text-align: center;
            cursor: pointer;
            font-weight: 900;
            border-radius: 15px;
            transition: 0.25s ease;
        }

        .logout-btn:hover {
            background: rgba(220,38,38,0.24);
            color: var(--white);
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .topbar {
            background: rgba(255,255,255,0.88);
            backdrop-filter: blur(18px);
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--slate-200);
            z-index: 5;
        }

        .topbar h2 {
            color: var(--slate-900);
            letter-spacing: -0.04em;
            font-size: 26px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--slate-500);
            font-weight: 800;
            font-size: 14px;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--slate-100);
            border: 1px solid var(--slate-200);
            padding: 10px 13px;
            border-radius: 14px;
            min-width: 260px;
        }

        .search-box input {
            border: none;
            outline: none;
            background: transparent;
            width: 100%;
            color: var(--slate-700);
        }

        .content-area {
            padding: 28px;
            flex: 1;
            overflow-y: auto;
        }

        .view-section {
            display: none;
            animation: fadeIn 0.35s ease;
        }

        .view-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-intro {
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            gap: 18px;
            margin-bottom: 22px;
        }

        .intro-card {
            flex: 1;
            background: linear-gradient(135deg, var(--white), #f0fdfa);
            padding: 24px;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
        }

        .intro-card h1, .intro-card h2 {
            color: var(--slate-900);
            letter-spacing: -0.04em;
            margin-bottom: 10px;
        }

        .intro-card p {
            color: var(--slate-600);
            line-height: 1.65;
            max-width: 980px;
        }

        .quick-actions {
            min-width: 270px;
            background: var(--slate-900);
            color: var(--white);
            padding: 22px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow);
        }

        .quick-actions h3 {
            margin-bottom: 14px;
            letter-spacing: -0.03em;
        }

        .quick-actions .btn-secondary {
            width: 100%;
            margin-top: 10px;
            justify-content: flex-start;
        }

        .grid-cards {
            display: grid;
            grid-template-columns: repeat(4, minmax(180px, 1fr));
            gap: 18px;
            margin-bottom: 22px;
        }

        .stat-card, .panel, .mini-panel {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-md);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
        }

        .stat-card {
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .stat-card::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 92px;
            height: 92px;
            border-radius: 0 0 0 100%;
            background: var(--accent, var(--primary-light));
            opacity: 0.55;
        }

        .stat-card h3 {
            color: var(--slate-500);
            font-size: 13px;
            font-weight: 900;
            text-transform: uppercase;
            margin-bottom: 8px;
            letter-spacing: 0.05em;
        }

        .stat-card .value {
            font-size: 31px;
            font-weight: 900;
            color: var(--slate-900);
            letter-spacing: -0.05em;
            margin-bottom: 8px;
        }

        .stat-card small {
            color: var(--slate-500);
            font-weight: 700;
        }

        .panel {
            padding: 24px;
            margin-bottom: 22px;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 20px;
        }

        .panel-header h2, .panel-header h3 {
            color: var(--slate-900);
            letter-spacing: -0.035em;
        }

        .panel-header p {
            color: var(--slate-500);
            margin-top: 6px;
            line-height: 1.5;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1.25fr 0.75fr;
            gap: 22px;
        }

        .three-col {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
        }

        .table-wrap {
            overflow-x: auto;
            border-radius: 14px;
            border: 1px solid var(--slate-200);
        }

        .data-table th, .data-table td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid var(--slate-200);
            vertical-align: middle;
        }

        .data-table th {
            background: var(--slate-50);
            color: var(--slate-600);
            font-weight: 900;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .data-table tr:hover td {
            background: #f0fdfa;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 900;
            white-space: nowrap;
        }

        .badge-green { background: #dcfce7; color: #166534; }
        .badge-yellow { background: #fef3c7; color: #92400e; }
        .badge-blue { background: #dbeafe; color: #1d4ed8; }
        .badge-red { background: #fee2e2; color: #991b1b; }
        .badge-purple { background: #ede9fe; color: #5b21b6; }
        .badge-gray { background: var(--slate-100); color: var(--slate-600); }

        .progress-list {
            display: grid;
            gap: 16px;
        }

        .progress-item {
            display: grid;
            gap: 8px;
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            color: var(--slate-700);
            font-size: 14px;
            font-weight: 800;
        }

        .progress-bar {
            height: 10px;
            border-radius: 999px;
            background: var(--slate-100);
            overflow: hidden;
        }

        .progress-bar span {
            display: block;
            height: 100%;
            width: var(--w);
            border-radius: inherit;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }

        .timeline {
            position: relative;
            display: grid;
            gap: 14px;
        }

        .timeline-item {
            display: grid;
            grid-template-columns: 74px 1fr;
            gap: 14px;
            align-items: start;
        }

        .timeline-time {
            color: var(--primary-dark);
            font-weight: 900;
            background: var(--primary-light);
            border-radius: 12px;
            padding: 8px;
            text-align: center;
            font-size: 13px;
        }

        .timeline-card {
            padding: 14px;
            border: 1px solid var(--slate-200);
            border-radius: 14px;
            background: var(--slate-50);
        }

        .timeline-card strong {
            display: block;
            color: var(--slate-900);
            margin-bottom: 4px;
        }

        .timeline-card small {
            color: var(--slate-500);
        }

        .doc-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .doc-card {
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: 18px;
            padding: 20px;
            cursor: pointer;
            transition: 0.25s ease;
            min-height: 150px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .doc-card:hover {
            border-color: var(--primary);
            background: #f0fdfa;
            transform: translateY(-3px);
        }

        .doc-card .doc-tag {
            align-self: flex-start;
            margin-bottom: 18px;
        }

        .doc-card h3 {
            color: var(--slate-900);
            margin-bottom: 8px;
        }

        .doc-card p {
            color: var(--slate-500);
            line-height: 1.45;
            font-size: 14px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .full {
            grid-column: 1 / -1;
        }

        .kanban {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .kanban-col {
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: 18px;
            padding: 14px;
            min-height: 320px;
        }

        .kanban-col h3 {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--slate-600);
            margin-bottom: 12px;
        }

        .task-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 12px;
            box-shadow: 0 8px 18px rgba(15,23,42,0.04);
        }

        .task-card strong {
            display: block;
            color: var(--slate-900);
            margin-bottom: 6px;
        }

        .task-card p {
            color: var(--slate-500);
            font-size: 13px;
            line-height: 1.45;
        }

        .notice {
            padding: 15px 16px;
            border-radius: 15px;
            background: #fffbeb;
            color: #92400e;
            border: 1px solid #fde68a;
            line-height: 1.55;
            font-weight: 700;
        }

        .mobile-toggle {
            display: none;
        }

        @media (max-width: 1180px) {
            .login-screen { grid-template-columns: 1fr; }
            .hero-panel { min-height: auto; gap: 60px; }
            .grid-cards { grid-template-columns: repeat(2, 1fr); }
            .two-col, .kanban { grid-template-columns: 1fr; }
        }

        @media (max-width: 900px) {
            .dashboard-screen { position: relative; }
            .sidebar {
                position: fixed;
                left: -310px;
                top: 0;
                bottom: 0;
                transition: 0.28s ease;
            }
            .sidebar.open { left: 0; }
            .mobile-toggle { display: inline-flex; }
            .section-intro, .topbar { flex-direction: column; align-items: stretch; }
            .quick-actions, .search-box { min-width: auto; }
            .doc-grid, .three-col, .form-grid { grid-template-columns: 1fr; }
            .full { grid-column: auto; }
        }

        @media (max-width: 680px) {
            .login-screen { padding: 18px; }
            .hero-panel { padding: 28px; border-radius: 24px; }
            .hero-metrics { grid-template-columns: 1fr; }
            .tabs { grid-template-columns: repeat(2, 1fr); }
            .login-header, .login-form, .tabs { padding-left: 22px; padding-right: 22px; }
            .content-area { padding: 18px; }
            .grid-cards { grid-template-columns: 1fr; }
            .topbar { padding: 16px 18px; }
        }
    </style>
</head>
