    <script>
        const roleNotes = {
            'Acesso: Médico': 'Médicos acessam agenda, pacientes, consultas e documentos clínicos.',
            'Acesso: Secretária': 'Secretárias acessam agenda, escala, pacientes e cadastros operacionais.',
            'Acesso: Diretor': 'Diretores possuem visão ampla: operação, produtividade, honorários e faturamento.',
            'Acesso: Administrador': 'Administradores visualizam todos os módulos e configurações do protótipo.'
        };

        const permissoesPorPerfil = {
            'Acesso: Médico': ['inicio', 'agenda', 'escala', 'pacientes', 'consultas', 'documentos'],
            'Acesso: Secretária': ['inicio', 'agenda', 'escala', 'pacientes', 'cadastros'],
            'Acesso: Diretor': ['inicio', 'agenda', 'escala', 'pacientes', 'consultas', 'documentos', 'salarios', 'financeiro', 'cadastros'],
            'Acesso: Administrador': ['inicio', 'agenda', 'escala', 'pacientes', 'consultas', 'documentos', 'salarios', 'financeiro', 'cadastros']
        };

        function changeTab(element, title) {
            document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
            element.classList.add('active');
            document.getElementById('role-note').innerText = roleNotes[title];
            document.getElementById('user').value = '';
            document.getElementById('password').value = '';
            document.getElementById('user').focus();
        }

        function realizarLogin(event) {
            event.preventDefault();
            const perfilRaw = document.querySelector('.tab-btn.active').innerText;
            const perfilMap = { 'Médico': 'Acesso: Médico', 'Secretária': 'Acesso: Secretária', 'Diretor': 'Acesso: Diretor', 'Admin': 'Acesso: Administrador' };
            const perfil = perfilMap[perfilRaw] || 'Acesso: Médico';
            const nomeUsuario = document.getElementById('user').value.trim() || 'Usuário';
            const iniciais = nomeUsuario.split(' ').filter(Boolean).slice(0, 2).map(p => p[0]).join('').toUpperCase();

            document.getElementById('dash-user-name').innerText = nomeUsuario;
            document.getElementById('dash-user-role').innerText = perfil.replace('Acesso: ', 'Perfil: ');
            document.getElementById('userAvatar').innerText = iniciais || 'U';
            document.getElementById('welcome-message').innerText = `Bem-vindo(a), ${nomeUsuario}!`;

            aplicarPermissoes(perfil);

            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('dashboardScreen').style.display = 'flex';

            abrirModulo('inicio');

            const dateOpts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('current-date').innerText = new Date().toLocaleDateString('pt-BR', dateOpts);
        }

        function aplicarPermissoes(perfil) {
            const permitidos = permissoesPorPerfil[perfil] || ['inicio'];
            document.querySelectorAll('.menu-item').forEach(item => {
                const mod = item.getAttribute('data-module');
                item.classList.toggle('locked', !permitidos.includes(mod));
            });
        }

        function navegarMenu(elementoClicado) {
            if (elementoClicado.classList.contains('locked')) {
                alert('Acesso bloqueado: este módulo é restrito para o perfil selecionado.');
                return;
            }
            const modulo = elementoClicado.getAttribute('data-module');
            abrirModulo(modulo);
        }

        function abrirModulo(modulo) {
            const item = document.querySelector(`[data-module="${modulo}"]`);
            if (!item || item.classList.contains('locked')) {
                alert('Este módulo não está disponível para o perfil atual.');
                return;
            }

            document.querySelectorAll('.menu-item').forEach(i => i.classList.remove('active-menu'));
            item.classList.add('active-menu');
            const textoMenu = item.getAttribute('data-title') || item.innerText.replace('Restrito', '').trim();
            document.getElementById('topbar-title').innerText = textoMenu;

            document.querySelectorAll('.view-section').forEach(sec => sec.classList.remove('active'));
            const section = document.getElementById('sec-' + modulo);
            if (section) section.classList.add('active');
            document.getElementById('sidebar').classList.remove('open');
        }

        function fazerLogout() {
            document.getElementById('dashboardScreen').style.display = 'none';
            document.getElementById('loginScreen').style.display = 'grid';
            document.getElementById('password').value = '';
            document.getElementById('globalSearch').value = '';
            filtrarTabelas('');
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }

        function mostrarAvisoDemo() {
            alert('Funcionalidade demonstrativa: como o projeto é apenas frontend, esta ação não salva dados em banco.');
        }

        function filtrarTabelas(valor) {
            const termo = valor.toLowerCase().trim();
            document.querySelectorAll('table.searchable tbody tr').forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(termo) ? '' : 'none';
            });
        }
    </script>
</body>
